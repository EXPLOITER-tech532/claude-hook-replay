{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node examples/hooks/guard-bash.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node examples/hooks/guard-env.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
